---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SERVICES } from '../copy';
---

<BaseLayout
  title={SERVICES.title}
  description={SERVICES.metaDescription}
  showHome={true}
>
  <div class="column">
    <h1 class="page-title">{SERVICES.title}</h1>
    <p class="quote svc__lede">{SERVICES.quote}</p>
    <p class="svc__sub">{SERVICES.sub}</p>

    <section class="svc__section">
      <h2 class="eyebrow">{SERVICES.offeringsHeading}</h2>
      <div class="offerings">
        {
          SERVICES.offerings.map((o, i) => (
            <div class="offering" data-reveal style={`--i:${i}`}>
              <h3 class="offering__title">{o.title}</h3>
              <p class="offering__body">{o.body}</p>
            </div>
          ))
        }
      </div>
    </section>

    <section class="svc__section">
      <div class="rule--h" aria-hidden="true" data-reveal></div>
      <h2 class="eyebrow svc__head">{SERVICES.processHeading}</h2>
      <ol class="steps">
        {
          SERVICES.steps.map((s, i) => (
            <li class="step" data-reveal style={`--i:${i}`}>
              <span class="step__n">{s.n}</span>
              <div>
                <h3 class="step__title">{s.title}</h3>
                <p class="step__body">{s.body}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="svc__section">
      <div class="rule--h" aria-hidden="true" data-reveal></div>
      <h2 class="eyebrow svc__head">{SERVICES.costHeading}</h2>
      <div class="prose">
        {SERVICES.costBody.map((para) => <p set:html={para} />)}
        <p>{SERVICES.costListIntro}</p>
        <ul>
          {SERVICES.costList.map((item) => <li>{item}</li>)}
        </ul>
      </div>
    </section>

    <section class="svc__section">
      <div class="rule--h" aria-hidden="true" data-reveal></div>
      <h2 class="eyebrow svc__head">{SERVICES.dontHeading}</h2>
      <div class="prose">
        <p>{SERVICES.dontBody}</p>
      </div>
    </section>

    <section class="svc__section">
      <div class="rule--h" aria-hidden="true" data-reveal></div>
      <p class="quote svc__cta-q">{SERVICES.ctaQuote}</p>
      <p class="svc__sub">{SERVICES.ctaBody}</p>
      <a href="/contact" class="btn svc__btn">{SERVICES.ctaButton}</a>
    </section>
  </div>
</BaseLayout>

<style>
  .svc__lede {
    margin-top: var(--s-2);
    max-width: 20ch;
  }

  .svc__sub {
    margin-top: var(--s-2);
    max-width: 52ch;
    color: var(--ink-soft);
  }

  .svc__section {
    margin-top: clamp(2.5rem, 7vw, var(--s-5));
  }

  .svc__head {
    margin-top: var(--s-3);
    display: block;
  }

  .offerings {
    margin-top: var(--s-3);
    display: grid;
    gap: var(--s-4);
  }

  .offering__title {
    font-size: var(--t-lg);
    font-weight: 600;
    letter-spacing: 1px;
  }

  .offering__body {
    margin-top: var(--s-1);
    max-width: 58ch;
  }

  .steps {
    margin-top: var(--s-3);
    list-style: none;
    display: grid;
    gap: var(--s-4);
  }

  .step {
    display: flex;
    gap: var(--s-3);
    align-items: baseline;
    max-width: 62ch;
  }

  .step__n {
    font-family: var(--serif);
    font-size: clamp(1.5rem, 1.2rem + 1.2vw, 2.4rem);
    line-height: 1;
    flex: none;
    color: var(--ink);
  }

  .step__title {
    font-size: var(--t-lg);
    font-weight: 600;
    letter-spacing: 1px;
  }

  .step__body {
    margin-top: var(--s-1);
    color: var(--ink-soft);
  }

  .svc__cta-q {
    margin-top: var(--s-4);
    max-width: 18ch;
  }

  .svc__btn {
    margin-top: var(--s-4);
  }
</style>
