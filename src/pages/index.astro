---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import WorkCard from '../components/WorkCard.astro';
import { SITE } from '../config';
import { HOME } from '../copy';

const work = (await getCollection('work', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order
);

const longestWord = (s: string) =>
  Math.max(...s.split(/\s+/).map((w) => w.length));

// One size for every word in the nav, decided by the longest of them. Sizing
// each word to its own length (as the menu overlay deliberately does) left
// these three at three unrelated sizes, because the short ones hit the --d-xl
// cap and the long ones didn't.
const navChars = Math.max(...HOME.bigNav.map((l) => longestWord(l.text)));
---

<BaseLayout
  title="Alex Partida"
  description={SITE.description}
  showWordmark={false}
  fill={true}
>
  <section class="split">
    <div class="split__text">
      <h1 class="intro__name">{HOME.name}</h1>
      {HOME.intro.map((line) => <p>{line}</p>)}
    </div>

    <nav class="split__display" aria-label="Sections" style={`--chars:${navChars}`}>
      {
        HOME.bigNav.map((l) => (
          <a href={l.href} class="big-link">
            {l.text}
          </a>
        ))
      }
    </nav>
  </section>

  <section class="home-work">
    <div class="rule--h" aria-hidden="true"></div>
    <h2 class="eyebrow home-work__head">{HOME.selectedWorkHeading}</h2>
    <div>
      {
        work.slice(0, 3).map((item) => (
          <WorkCard
            href={`/work/${item.id}/`}
            client={item.data.client}
            title={item.data.title}
            summary={item.data.summary}
            year={item.data.year}
            stack={item.data.stack}
          />
        ))
      }
    </div>
    <p class="home-work__more">
      <a href="/work" class="link-u">{HOME.allWorkLink}</a>
    </p>
  </section>

  <section class="home-cta">
    <div class="rule--h" aria-hidden="true"></div>
    <p class="quote home-cta__quote">{HOME.ctaQuote}</p>
    <p class="home-cta__body">{HOME.ctaBody}</p>
    <a href="/contact" class="btn">{HOME.ctaButton}</a>
  </section>
</BaseLayout>

<style>
  /* The name sits at body size, as it did originally — the display
     type on the right is what carries the page. */
  .intro__name {
    font-size: var(--t-0);
    font-weight: 600;
    letter-spacing: 2px;
    text-transform: uppercase;
  }

  .split__text p {
    margin-top: var(--s-2);
  }

  .home-work {
    padding-block: clamp(2.5rem, 7vw, var(--s-5)) 0;
  }

  .home-work__head {
    margin-top: var(--s-3);
    display: block;
  }

  .home-work__more {
    margin-top: var(--s-3);
    font-size: var(--t-sm);
    letter-spacing: 2px;
    text-transform: uppercase;
  }

  .home-cta {
    padding-top: clamp(2.5rem, 7vw, var(--s-5));
  }

  .home-cta__quote {
    margin-top: var(--s-4);
    max-width: 18ch;
  }

  .home-cta__body {
    margin-top: var(--s-2);
    max-width: 52ch;
    color: var(--ink-soft);
  }

  .home-cta .btn {
    margin-top: var(--s-4);
  }
</style>
