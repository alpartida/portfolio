---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import WorkCard from '../components/WorkCard.astro';
import { SITE } from '../config';

const work = (await getCollection('work', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order
);

// Longest word decides the type size, so a word can never outrun its column.
const longestWord = (s: string) =>
  Math.max(...s.split(/\s+/).map((w) => w.length));

// The giant words are the navigation, the way the original site worked.
const bigNav = [
  { text: 'Work', href: '/work' },
  { text: 'Services', href: '/services' },
  { text: 'Contact', href: '/contact' },
];
---

<BaseLayout
  title="Alex Partida"
  description={SITE.description}
  showWordmark={false}
  fill={true}
>
  <section class="split">
    <div class="split__text">
      <h1 class="intro__name">Alex Partida</h1>
      <p>Web Developer. Designer. Los Angeles.</p>
      <p>
        Creating beautiful and engaging digital experiences — and building
        websites that small businesses can actually run themselves.
      </p>
      <p>
        Currently a web developer at The Salt Lake Tribune, and taking on a
        small number of freelance projects.
      </p>
    </div>

    <nav class="split__display" aria-label="Sections">
      {
        bigNav.map((l) => (
          <a
            href={l.href}
            class="big-link"
            style={`--chars:${longestWord(l.text)}`}
          >
            {l.text}
          </a>
        ))
      }
    </nav>
  </section>

  <section class="home-work">
    <div class="rule--h" aria-hidden="true"></div>
    <h2 class="eyebrow home-work__head">Selected work</h2>
    <div>
      {
        work.slice(0, 3).map((item) => (
          <WorkCard
            href={`/work/${item.id}/`}
            client={item.data.client}
            title={item.data.title}
            summary={item.data.summary}
            year={item.data.year}
            stack={item.data.stack}
          />
        ))
      }
    </div>
    <p class="home-work__more">
      <a href="/work" class="link-u">All work</a>
    </p>
  </section>

  <section class="home-cta">
    <div class="rule--h" aria-hidden="true"></div>
    <p class="quote home-cta__quote">Have something in mind?</p>
    <p class="home-cta__body">
      Tell me what you're trying to build and what's in the way. I'll tell you
      honestly whether I'm the right person for it.
    </p>
    <a href="/contact" class="btn">Start a project</a>
  </section>
</BaseLayout>

<style>
  /* The name sits at body size, as it did originally — the display
     type on the right is what carries the page. */
  .intro__name {
    font-size: var(--t-0);
    font-weight: 600;
    letter-spacing: 2px;
    text-transform: uppercase;
  }

  .home-work {
    padding-block: clamp(2.5rem, 7vw, var(--s-5)) 0;
  }

  .home-work__head {
    margin-top: var(--s-3);
  }

  .home-work__more {
    margin-top: var(--s-3);
    font-size: var(--t-sm);
    letter-spacing: 2px;
    text-transform: uppercase;
  }

  .home-cta {
    padding-top: clamp(2.5rem, 7vw, var(--s-5));
  }

  .home-cta__quote {
    margin-top: var(--s-4);
    max-width: 18ch;
  }

  .home-cta__body {
    margin-top: var(--s-2);
    max-width: 52ch;
    color: var(--ink-soft);
  }

  .home-cta .btn {
    margin-top: var(--s-4);
  }
</style>
