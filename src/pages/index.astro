---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../config';
import { HOME } from '../copy';

const longestWord = (s: string) =>
  Math.max(...s.split(/\s+/).map((w) => w.length));

// One size for every word in the nav, decided by the longest of them. Sizing
// each word to its own length (as the menu overlay deliberately does) left
// these three at three unrelated sizes, because the short ones hit the --d-xl
// cap and the long ones didn't.
const navChars = Math.max(...HOME.bigNav.map((l) => longestWord(l.text)));


/*
 * The homepage is the intro and the three giant words, and that is the whole
 * design. There was a "Selected work" block and a pill-button CTA beneath it
 * for a while — the hero / selected-work / call-to-action shape every
 * template has — and it read as a second, more ordinary website bolted under
 * this one. The work lives at /work, where the client names get the same
 * display treatment these nav words do.
 */
---

<BaseLayout
  title="Alex Partida"
  description={SITE.description}
  showWordmark={false}
  fill={true}
>
  <section class="split">
    <div class="split__text">
      <h1 class="intro__name" style="--j:0">{HOME.name}</h1>
      {HOME.intro.map((line, i) => <p style={`--j:${i + 1}`}>{line}</p>)}

      <div class="intro__rule" aria-hidden="true" style={`--j:${HOME.intro.length + 1}`}></div>

      <p class="quote intro__cta" style={`--j:${HOME.intro.length + 2}`}>
        {HOME.ctaQuote} <a href="/contact" class="link-u">{HOME.ctaLink}</a>
      </p>
    </div>

    <nav class="split__display" aria-label="Sections" style={`--chars:${navChars}`}>
      {
        HOME.bigNav.map((l, i) => (
          <span class="big-word" style={`--i:${i}`}>
            <a
              href={l.href}
              class="big-link"
              transition:name={`nav-${l.text.toLowerCase()}`}
            >
              {l.text}
            </a>
          </span>
        ))
      }
    </nav>
  </section>
</BaseLayout>

<style>
  /* The words arrive one after another rather than all at once. The
     animation is on this wrapper, not on the link: a `both` fill mode
     holds the final transform and would otherwise outrank the skew on
     hover, killing it. */
  .big-word {
    display: block;
  }

  @media (prefers-reduced-motion: no-preference) {
    .big-word {
      animation: word-in 0.8s var(--ease-out) both;
      animation-delay: calc(var(--i) * 120ms + 120ms);
    }

    @keyframes word-in {
      from {
        opacity: 0;
        transform: translateY(0.22em);
      }
      to {
        opacity: 1;
        transform: none;
      }
    }

    /* The intro lines follow the same cadence on the other side. */
    .split__text > * {
      animation: word-in 0.7s var(--ease-out) both;
      animation-delay: calc(var(--j, 0) * 90ms);
    }
  }

  /* The name sits at body size, as it did originally — the display
     type on the right is what carries the page. */
  .intro__name {
    font-size: var(--t-0);
    font-weight: 600;
    letter-spacing: 2px;
    text-transform: uppercase;
  }

  .split__text > p {
    margin-top: var(--s-2);
  }

  /* A short hairline rather than a full-width rule — it separates the
     invitation from the intro without turning the column into sections. */
  .intro__rule {
    margin-top: var(--s-4);
    width: 3.5rem;
    height: var(--rule-w);
    background: var(--ink);
  }

  /* One sentence, one typeface, one size: the question and the invitation
     read as a single thought, and the serif keeps it clear of the display
     type opposite rather than competing with it at a smaller size. */
  .split__text > .intro__cta {
    margin-top: var(--s-3);
    max-width: 26ch;
    text-wrap: balance;
  }

  .intro__cta .link-u {
    text-underline-offset: 0.18em;
  }

  .intro__cta .link-u:hover,
  .intro__cta .link-u:focus-visible {
    text-underline-offset: 0.3em;
  }
</style>
