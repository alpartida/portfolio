---
import BaseLayout from '../layouts/BaseLayout.astro';
import { NOT_FOUND } from '../copy';
---

<BaseLayout
  title="Page not found"
  description="That page doesn't exist."
  noindex={true}
  showHome={true}
>
  <div class="column">
    <h1 class="page-title">{NOT_FOUND.title}</h1>
    <p class="quote nf__q">{NOT_FOUND.quote}</p>
    <p class="nf__sub">{NOT_FOUND.body}</p>
    <div class="cluster nf__actions">
      <a href="/work" class="btn">{NOT_FOUND.seeWork}</a>
      <a href="/" class="link-u nf__link">{NOT_FOUND.backHome}</a>
    </div>
  </div>
</BaseLayout>

<style>
  .nf__q {
    margin-top: var(--s-2);
  }
  .nf__sub {
    margin-top: var(--s-2);
    max-width: 50ch;
    color: var(--ink-soft);
  }
  .nf__actions {
    margin-top: var(--s-4);
  }
  .nf__link {
    font-size: var(--t-sm);
    letter-spacing: 2px;
    text-transform: uppercase;
  }
</style>
