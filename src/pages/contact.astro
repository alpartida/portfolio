---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../config';
---

<BaseLayout
  title="Contact"
  description="Tell me about your project. Fixed-price web design and development for small businesses and independent practitioners in Los Angeles and remote."
>
  <section class="page-head">
    <div class="container">
      <p class="eyebrow">Contact</p>
      <h1>Tell me what you're trying to build.</h1>
      <p class="lede">
        The more you can tell me about the problem, the more useful my first
        reply will be. I answer everything within two business days.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container contact-layout">
      <!--
        Netlify Forms: the `data-netlify` attribute is what registers this form
        on deploy. Submissions appear under Forms in the Netlify dashboard;
        turn on email notifications there to get them in your inbox.
      -->
      <form
        class="form"
        name="project-enquiry"
        method="POST"
        data-netlify="true"
        netlify-honeypot="bot-field"
        action="/thanks/"
      >
        <p class="visually-hidden">
          <label>
            Don't fill this out if you're human: <input name="bot-field" />
          </label>
        </p>

        <div class="field">
          <label for="name">Your name</label>
          <input id="name" name="name" type="text" autocomplete="name" required />
        </div>

        <div class="field">
          <label for="email">Email</label>
          <input
            id="email"
            name="email"
            type="email"
            autocomplete="email"
            required
          />
        </div>

        <div class="field">
          <label for="business">Business or practice <span class="opt">(optional)</span></label>
          <input id="business" name="business" type="text" autocomplete="organization" />
        </div>

        <div class="field">
          <label for="website">Current website <span class="opt">(optional)</span></label>
          <input
            id="website"
            name="website"
            type="url"
            inputmode="url"
            placeholder="https://"
          />
        </div>

        <div class="field">
          <label for="need">What do you need?</label>
          <select id="need" name="need" required>
            <option value="">Choose one…</option>
            <option>A new site, start to finish</option>
            <option>Rebuilding a site I can't update myself</option>
            <option>Making an existing site faster or findable</option>
            <option>Something else</option>
          </select>
        </div>

        <div class="field">
          <label for="budget">Rough budget</label>
          <select id="budget" name="budget" required>
            <option value="">Choose one…</option>
            <option>Under $2,000</option>
            <option>$2,000 – $5,000</option>
            <option>$5,000 – $10,000</option>
            <option>More than $10,000</option>
            <option>I genuinely don't know yet</option>
          </select>
          <p class="hint">
            An honest range saves us both a call. "I don't know yet" is a fine
            answer.
          </p>
        </div>

        <div class="field">
          <label for="timeline">When do you need it?</label>
          <select id="timeline" name="timeline" required>
            <option value="">Choose one…</option>
            <option>As soon as possible</option>
            <option>Within a month or two</option>
            <option>Within six months</option>
            <option>No fixed deadline</option>
          </select>
        </div>

        <div class="field">
          <label for="message">What's the problem you're trying to solve?</label>
          <textarea id="message" name="message" rows="6" required></textarea>
        </div>

        <button type="submit" class="btn btn--primary">Send enquiry</button>
      </form>

      <aside class="aside">
        <div class="card stack-sm">
          <h2 class="aside__title">What happens next</h2>
          <ol class="aside__list">
            <li>I reply within two business days.</li>
            <li>If it looks like a fit, we talk for half an hour. Free.</li>
            <li>You get a fixed-price proposal in writing before anything starts.</li>
          </ol>
        </div>

        <div class="stack-sm aside__block">
          <h2 class="aside__title">Where I work</h2>
          <p class="aside__note">
            Based in {SITE.location}, working with clients here and remotely.
            Most projects run entirely over email and a couple of calls.
          </p>
        </div>

        <div class="stack-sm aside__block">
          <h2 class="aside__title">Elsewhere</h2>
          <ul class="aside__list aside__list--plain">
            <li><a href={SITE.linkedin}>LinkedIn</a></li>
            <li><a href={SITE.github}>GitHub</a></li>
          </ul>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>

<style>
  .page-head {
    padding-block: clamp(2.5rem, 8vw, 5.5rem) 0;
  }

  .page-head h1 {
    margin-top: var(--s-2);
    max-width: 26ch;
  }

  .page-head .lede {
    margin-top: var(--s-3);
  }

  .contact-layout {
    display: grid;
    gap: var(--s-5);
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    align-items: start;
  }

  @media (max-width: 820px) {
    .contact-layout {
      grid-template-columns: 1fr;
      gap: var(--s-4);
    }
  }

  .form {
    display: grid;
    gap: var(--s-3);
    max-width: 34rem;
  }

  .field {
    display: grid;
    gap: 0.4rem;
  }

  label {
    font-size: var(--step--1);
    font-weight: 500;
    letter-spacing: 0.02em;
  }

  .opt {
    font-weight: 400;
    color: var(--ink-soft);
  }

  input,
  select,
  textarea {
    font-family: inherit;
    font-size: var(--step-0);
    color: var(--ink);
    background: var(--paper);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    padding: 0.7em 0.85em;
    width: 100%;
    transition: border-color 0.15s ease;
  }

  input:hover,
  select:hover,
  textarea:hover {
    border-color: var(--ink-soft);
  }

  textarea {
    resize: vertical;
    line-height: 1.55;
  }

  .hint {
    font-size: var(--step--1);
    color: var(--ink-soft);
  }

  .form .btn {
    justify-self: start;
    margin-top: var(--s-1);
  }

  .aside__title {
    font-size: var(--step-1);
  }

  .aside__block {
    margin-top: var(--s-4);
  }

  .aside__note {
    font-size: var(--step--1);
    color: var(--ink-soft);
  }

  .aside__list {
    color: var(--ink-soft);
    padding-left: 1.2em;
  }

  .aside__list li + li {
    margin-top: var(--s-1);
  }

  .aside__list--plain {
    list-style: none;
    padding-left: 0;
  }
</style>
