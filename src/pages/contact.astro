---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../config';
---

<BaseLayout
  title="Contact"
  description="Tell me about your project. Fixed-price web design and development for small businesses and independent practitioners in Los Angeles and remote."
  showHome={true}
>
  <div class="column">
    <h1 class="page-title">Contact</h1>
    <p class="quote ct__lede">Tell me what you're trying to build.</p>
    <p class="ct__sub">
      The more you can tell me about the problem, the more useful my first reply
      will be. I answer everything within two business days.
    </p>

    <div class="ct__layout">
      <!--
        Netlify Forms: the `data-netlify` attribute is what registers this form
        on deploy. Submissions appear under Forms in the Netlify dashboard;
        turn on email notifications there to get them in your inbox.
      -->
      <form
        class="form"
        name="project-enquiry"
        method="POST"
        data-netlify="true"
        netlify-honeypot="bot-field"
        action="/thanks/"
      >
        <p class="visually-hidden">
          <label>
            Don't fill this out if you're human: <input name="bot-field" />
          </label>
        </p>

        <div class="field">
          <label for="name">Your name</label>
          <input id="name" name="name" type="text" autocomplete="name" required />
        </div>

        <div class="field">
          <label for="email">Email</label>
          <input id="email" name="email" type="email" autocomplete="email" required />
        </div>

        <div class="field">
          <label for="business">Business or practice <span class="opt">(optional)</span></label>
          <input id="business" name="business" type="text" autocomplete="organization" />
        </div>

        <div class="field">
          <label for="website">Current website <span class="opt">(optional)</span></label>
          <input id="website" name="website" type="url" inputmode="url" placeholder="https://" />
        </div>

        <div class="field">
          <label for="need">What do you need?</label>
          <select id="need" name="need" required>
            <option value="">Choose one…</option>
            <option>A new site, start to finish</option>
            <option>Rebuilding a site I can't update myself</option>
            <option>Making an existing site faster or findable</option>
            <option>Something else</option>
          </select>
        </div>

        <div class="field">
          <label for="budget">Rough budget</label>
          <select id="budget" name="budget" required>
            <option value="">Choose one…</option>
            <option>Under $2,000</option>
            <option>$2,000 – $5,000</option>
            <option>$5,000 – $10,000</option>
            <option>More than $10,000</option>
            <option>I genuinely don't know yet</option>
          </select>
          <p class="hint">
            An honest range saves us both a call. "I don't know yet" is a fine
            answer.
          </p>
        </div>

        <div class="field">
          <label for="timeline">When do you need it?</label>
          <select id="timeline" name="timeline" required>
            <option value="">Choose one…</option>
            <option>As soon as possible</option>
            <option>Within a month or two</option>
            <option>Within six months</option>
            <option>No fixed deadline</option>
          </select>
        </div>

        <div class="field">
          <label for="message">What's the problem you're trying to solve?</label>
          <textarea id="message" name="message" rows="6" required></textarea>
        </div>

        <button type="submit" class="btn">Send enquiry</button>
      </form>

      <aside class="aside">
        <h2 class="eyebrow">What happens next</h2>
        <ol class="aside__list">
          <li>I reply within two business days.</li>
          <li>If it looks like a fit, we talk for half an hour. Free.</li>
          <li>You get a fixed-price proposal in writing before anything starts.</li>
        </ol>

        <h2 class="eyebrow aside__head">Where I work</h2>
        <p class="aside__note">
          Based in {SITE.location}, working with clients here and remotely. Most
          projects run entirely over email and a couple of calls.
        </p>

        <h2 class="eyebrow aside__head">Elsewhere</h2>
        <ul class="aside__plain">
          <li><a href={SITE.linkedin} class="link-u">LinkedIn</a></li>
          <li><a href={SITE.github} class="link-u">GitHub</a></li>
        </ul>
      </aside>
    </div>
  </div>
</BaseLayout>

<style>
  .ct__lede {
    margin-top: var(--s-2);
    max-width: 22ch;
  }

  .ct__sub {
    margin-top: var(--s-2);
    max-width: 52ch;
    color: var(--ink-soft);
  }

  .ct__layout {
    margin-top: clamp(2.5rem, 7vw, var(--s-5));
    display: grid;
    gap: var(--s-5);
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
    align-items: start;
  }

  @media (max-width: 820px) {
    .ct__layout {
      grid-template-columns: 1fr;
      gap: var(--s-4);
    }
  }

  .form {
    display: grid;
    gap: var(--s-3);
    max-width: 32rem;
  }

  .field {
    display: grid;
    gap: 0.5rem;
  }

  label {
    font-size: var(--t-sm);
    font-weight: 500;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    line-height: 1.6;
  }

  .opt {
    font-weight: 400;
    text-transform: none;
    letter-spacing: var(--track);
    color: var(--ink-soft);
  }

  /* Underlines rather than boxes — closer to the original's flat,
     hairline-driven look than a bordered input would be. */
  input,
  select,
  textarea {
    font-family: var(--body);
    font-size: var(--t-0);
    letter-spacing: var(--track);
    color: var(--ink);
    background: transparent;
    border: none;
    border-bottom: var(--rule-w) solid var(--ink-soft);
    border-radius: 0;
    padding: 0.6em 0.1em;
    width: 100%;
    transition: border-color 0.2s ease;
  }

  select {
    /* Keep the native arrow visible against a transparent field. */
    appearance: none;
    background-image: linear-gradient(45deg, transparent 50%, currentColor 50%),
      linear-gradient(135deg, currentColor 50%, transparent 50%);
    background-position: right 0.75em top 55%, right 0.3em top 55%;
    background-size: 0.4em 0.4em, 0.4em 0.4em;
    background-repeat: no-repeat;
    padding-right: 1.8em;
  }

  input:hover,
  select:hover,
  textarea:hover,
  input:focus,
  select:focus,
  textarea:focus {
    border-bottom-color: var(--ink);
  }

  textarea {
    resize: vertical;
    line-height: 1.8;
    border: var(--rule-w) solid var(--ink-soft);
    padding: 0.7em 0.8em;
  }

  .hint {
    font-size: var(--t-sm);
    line-height: 1.7;
    color: var(--ink-soft);
  }

  .form .btn {
    justify-self: start;
    margin-top: var(--s-2);
  }

  .aside__list {
    margin-top: var(--s-2);
    padding-left: 1.3em;
    color: var(--ink-soft);
    font-size: var(--t-sm);
    line-height: 1.9;
  }

  .aside__head {
    display: block;
    margin-top: var(--s-4);
  }

  .aside__note {
    margin-top: var(--s-2);
    font-size: var(--t-sm);
    line-height: 1.9;
    color: var(--ink-soft);
  }

  .aside__plain {
    margin-top: var(--s-2);
    list-style: none;
    font-size: var(--t-sm);
    letter-spacing: 2px;
    text-transform: uppercase;
    display: grid;
    gap: var(--s-1);
  }
</style>
