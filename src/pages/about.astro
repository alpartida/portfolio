---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import { ABOUT } from '../copy';
import portrait from '../images/alex-portrait.jpeg';
import family from '../images/family.jpeg';
import otis from '../images/otis.jpeg';
import meredithAndFiru from '../images/meredith-and-firu.jpeg';
---

<BaseLayout
  title={ABOUT.title}
  description={ABOUT.metaDescription}
  showHome={true}
>
  <div class="about">
    <!-- The portrait bleeds off the right edge, as it did originally. -->
    <Image
      src={portrait}
      alt={ABOUT.alts.portrait}
      class="about__portrait"
      widths={[320, 480, 720]}
      sizes="(max-width: 860px) 40vw, 360px"
      loading="eager"
    />

    <div class="column about__col">
      <h1 class="page-title">{ABOUT.title}</h1>
      <p class="quote">{ABOUT.quote}</p>

      <div class="prose about__prose">
        {ABOUT.intro.map((para) => <p set:html={para} />)}

        <h2>{ABOUT.craftHeading}</h2>
        {ABOUT.craft.map((para) => <p set:html={para} />)}

        <h2>{ABOUT.personalHeading}</h2>
        {ABOUT.personal.map((para) => <p set:html={para} />)}
      </div>

      <div class="gallery">
        <figure>
          <Image
            src={family}
            alt={ABOUT.alts.family}
            widths={[320, 560, 760]}
            sizes="(max-width: 760px) 90vw, 340px"
            loading="lazy"
          />
        </figure>
        <figure>
          <Image
            src={otis}
            alt={ABOUT.alts.otis}
            widths={[320, 560]}
            sizes="(max-width: 760px) 44vw, 230px"
            loading="lazy"
          />
        </figure>
        <figure>
          <Image
            src={meredithAndFiru}
            alt={ABOUT.alts.cats}
            widths={[320, 560]}
            sizes="(max-width: 760px) 44vw, 230px"
            loading="lazy"
          />
        </figure>
      </div>

      <p class="about__cv-note">{ABOUT.cvNote}</p>
      <div class="cluster about__actions">
        <a href="/AlexPartidaResume.pdf" class="btn" download>{ABOUT.cvButton}</a>
        <a href="/contact" class="link-u about__link">{ABOUT.cvLink}</a>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .about {
    position: relative;
  }

  .about__col {
    position: relative;
    z-index: 2;
  }

  /* Originally absolutely positioned and bleeding off the right. Kept,
     but clipped to the viewport so it can't create a scrollbar. */
  .about__portrait {
    position: absolute;
    top: 0;
    right: calc(var(--gutter) * -1);
    width: min(360px, 34vw);
    height: auto;
    z-index: 1;
  }

  .about__prose,
  .about__col .quote {
    max-width: 44ch;
  }

  @media (max-width: 860px) {
    .about__portrait {
      width: 38vw;
      opacity: 0.55;
      right: 0;
    }

    .about__prose,
    .about__col .quote {
      max-width: none;
    }
  }

  .gallery {
    margin-top: var(--s-5);
    display: grid;
    gap: var(--s-2);
    grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
  }

  .gallery img {
    border: var(--rule-w) solid var(--rule-soft);
    width: 100%;
    height: 100%;
    object-fit: cover;
    aspect-ratio: 4 / 3;
  }

  .about__cv-note {
    margin-top: var(--s-5);
    color: var(--ink-soft);
  }

  .about__actions {
    margin-top: var(--s-3);
  }

  .about__link {
    font-size: var(--t-sm);
    letter-spacing: 2px;
    text-transform: uppercase;
  }
</style>
