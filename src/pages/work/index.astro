---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import WorkCard from '../../components/WorkCard.astro';

const work = (await getCollection('work', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order
);
---

<BaseLayout
  title="Work"
  description="Case studies: a yoga teaching site driven by a Google Sheet, a Los Angeles tax practice, and three years of newsletter, subscription and revenue work at The Salt Lake Tribune."
>
  <section class="page-head">
    <div class="container">
      <p class="eyebrow">Work</p>
      <h1>Things I've built, and why they're built that way.</h1>
      <p class="lede">
        Each of these is a real client or employer project. The interesting part
        is rarely the technology — it's the constraint that shaped it.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="work-list">
        {
          work.map((item) => (
            <WorkCard
              href={`/work/${item.id}/`}
              client={item.data.client}
              title={item.data.title}
              summary={item.data.summary}
              year={item.data.year}
              stack={item.data.stack}
            />
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-head {
    padding-block: clamp(2.5rem, 8vw, 5.5rem) 0;
  }

  .page-head h1 {
    margin-top: var(--s-2);
    max-width: 26ch;
  }

  .page-head .lede {
    margin-top: var(--s-3);
  }

  .work-list {
    border-bottom: 1px solid var(--rule);
  }
</style>
