---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { WORK } from '../../copy';

const work = (await getCollection('work', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order
);

// Longest word decides the type size, so a long client name wraps
// onto another line instead of running off the right edge.
const longestWord = (s: string) =>
  Math.max(...s.split(/\s+/).map((w) => w.length));
---

<BaseLayout
  title="Work"
  description={WORK.metaDescription}
  showHome={true}
  fill={true}
>
  <section class="split">
    <div class="split__text">
      <h1 class="page-title">{WORK.title}</h1>
      {WORK.intro.map((line) => <p class="work-intro__p">{line}</p>)}
    </div>

    <nav class="split__display" aria-label="Case studies">
      {
        work.map((item) => (
          <span class="wl">
            <a
              href={`/work/${item.id}/`}
              class="big-link big-link--md"
              style={`--chars:${longestWord(item.data.client)}`}
            >
              {item.data.client}
            </a>
            <span class="meta wl__meta">{item.data.year}</span>
          </span>
        ))
      }
    </nav>
  </section>
</BaseLayout>

<style>
  .work-intro__p + .work-intro__p {
    margin-top: var(--s-2);
  }

  .wl {
    display: block;
    margin-bottom: var(--s-3);
  }

  .wl__meta {
    display: block;
    margin-top: -0.4em;
  }
</style>
