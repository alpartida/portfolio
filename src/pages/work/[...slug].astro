---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  // Drafts are visible with `npm run dev` so you can read them back, but are
  // never built for production — so an unfinished case study can't be indexed
  // or shared before you've decided to publish it.
  const work = await getCollection(
    'work',
    ({ data }) => import.meta.env.DEV || !data.draft
  );
  return work.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;

// The client name is short enough for the display face; the title isn't.
const longestWord = (s: string) =>
  Math.max(...s.split(/\s+/).map((w) => w.length));
---

<BaseLayout
  title={`${d.client} — ${d.title}`}
  description={d.summary}
  type="article"
  showHome={true}
>
  <article class="column">
    <header>
      <p
        class="display case__client"
        style={`--chars:${longestWord(d.client)}`}
      >
        {d.client}
      </p>
      <h1 class="case__title">{d.title}</h1>
      <p class="case__lede">{d.lede}</p>

      <dl class="facts">
        <div>
          <dt class="meta">Role</dt>
          <dd>{d.role}</dd>
        </div>
        <div>
          <dt class="meta">Year</dt>
          <dd>{d.year}</dd>
        </div>
        <div class="facts__stack">
          <dt class="meta">Built with</dt>
          <dd>
            <ul class="tags">
              {d.stack.map((s: string) => <li class="tag">{s}</li>)}
            </ul>
          </dd>
        </div>
      </dl>

      {
        d.liveUrl && (
          <p class="case__live">
            <a href={d.liveUrl} class="btn btn--ghost">
              Visit the live site
            </a>
          </p>
        )
      }
    </header>

    <div class="rule--h case__divider" aria-hidden="true" data-reveal></div>

    <div class="prose">
      <Content />
    </div>

    <footer class="case__foot">
      <div class="rule--h" aria-hidden="true" data-reveal></div>
      <p class="quote case__foot-q">Want something like this?</p>
      <div class="cluster case__actions">
        <a href="/contact" class="btn">Start a project</a>
        <a href="/work" class="link-u case__back">All work</a>
      </div>
    </footer>
  </article>
</BaseLayout>

<style>
  /* Establish the container the display sizing measures against. */
  .column {
    container-type: inline-size;
  }

  /* Bungee Shade sized to the column, as on the work index. */
  .case__client {
    font-size: min(var(--d-md), calc(100cqw / (var(--chars) * 0.9)));
    line-height: 1.05em;
    padding-right: 0.08em;
  }

  .case__title {
    margin-top: var(--s-3);
    font-family: var(--body);
    font-weight: 600;
    font-size: var(--t-lg);
    line-height: 1.5;
    max-width: 36ch;
  }

  .case__lede {
    margin-top: var(--s-2);
    max-width: 54ch;
    color: var(--ink-soft);
  }

  .facts {
    margin-top: var(--s-4);
    display: grid;
    gap: var(--s-3);
    grid-template-columns: repeat(auto-fit, minmax(9rem, auto));
    align-items: start;
  }

  .facts__stack {
    grid-column: 1 / -1;
  }

  .facts dd {
    margin-top: 0.3em;
    font-size: var(--t-0);
    line-height: 1.7;
  }

  .case__live {
    margin-top: var(--s-4);
  }

  .case__divider {
    margin-block: clamp(2.5rem, 6vw, var(--s-5));
  }

  .case__foot {
    margin-top: clamp(2.5rem, 7vw, var(--s-5));
  }

  .case__foot-q {
    margin-top: var(--s-4);
    max-width: 20ch;
  }

  .case__actions {
    margin-top: var(--s-3);
  }

  .case__back {
    font-size: var(--t-sm);
    letter-spacing: 2px;
    text-transform: uppercase;
  }

  /* The MDX opens with a figure or an h2; neither should carry the
     default top margin straight after the divider. */
  .prose :global(> :first-child) {
    margin-top: 0;
  }
</style>
