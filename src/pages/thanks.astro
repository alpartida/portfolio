---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Thanks" description="Your enquiry is in." noindex={true} showHome={true}>
  <div class="column">
    <h1 class="page-title">Thanks</h1>
    <p class="quote th__q">That's in.</p>
    <p class="th__sub">
      I'll read it properly and reply within two business days. If it's urgent,
      reply to my first email and say so — it'll jump the queue.
    </p>
    <div class="cluster th__actions">
      <a href="/work" class="btn btn--ghost">Read a case study</a>
      <a href="/" class="link-u th__link">Back home</a>
    </div>
  </div>
</BaseLayout>

<style>
  .th__q {
    margin-top: var(--s-2);
  }
  .th__sub {
    margin-top: var(--s-2);
    max-width: 50ch;
    color: var(--ink-soft);
  }
  .th__actions {
    margin-top: var(--s-4);
  }
  .th__link {
    font-size: var(--t-sm);
    letter-spacing: 2px;
    text-transform: uppercase;
  }
</style>
