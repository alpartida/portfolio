---
import BaseLayout from '../layouts/BaseLayout.astro';
import { THANKS } from '../copy';
---

<BaseLayout title="Thanks" description="Your enquiry is in." noindex={true} showHome={true}>
  <div class="column">
    <h1 class="page-title">{THANKS.title}</h1>
    <p class="quote th__q">{THANKS.quote}</p>
    <p class="th__sub">{THANKS.body}</p>
    <div class="cluster th__actions">
      <a href="/work" class="btn btn--ghost">{THANKS.readWork}</a>
      <a href="/" class="link-u th__link">{THANKS.backHome}</a>
    </div>
  </div>
</BaseLayout>

<style>
  .th__q {
    margin-top: var(--s-2);
  }
  .th__sub {
    margin-top: var(--s-2);
    max-width: 50ch;
    color: var(--ink-soft);
  }
  .th__actions {
    margin-top: var(--s-4);
  }
  .th__link {
    font-size: var(--t-sm);
    letter-spacing: 2px;
    text-transform: uppercase;
  }
</style>
