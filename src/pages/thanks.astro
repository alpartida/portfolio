---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Thanks" description="Your enquiry is in." noindex={true}>
  <section class="centered">
    <div class="container">
      <p class="eyebrow">Sent</p>
      <h1>Thanks — that's in.</h1>
      <p class="lede">
        I'll read it properly and reply within two business days. If it's
        urgent, reply to my first email and say so — it'll jump the queue.
      </p>
      <div class="cluster actions">
        <a href="/work" class="btn btn--ghost">Read a case study</a>
        <a href="/" class="btn btn--ghost">Back home</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .centered {
    padding-block: clamp(4rem, 14vw, 9rem);
  }
  h1 {
    margin-top: var(--s-2);
    max-width: 20ch;
  }
  .lede {
    margin-top: var(--s-3);
  }
  .actions {
    margin-top: var(--s-4);
  }
</style>
