---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import SEO from '../components/SEO.astro';
import Header from '../components/Header.astro';
import SideRail from '../components/SideRail.astro';
import MenuOverlay from '../components/MenuOverlay.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../config';

export interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  /** Homepage suppresses the wordmark — the giant type says it already. */
  showWordmark?: boolean;
  /** Inner pages get the rotated "Home" link in the rail, as the original did. */
  showHome?: boolean;
  /** Full-height centred layout for the homepage split. */
  fill?: boolean;
}

const {
  title,
  description = SITE.description,
  image,
  type,
  noindex,
  showWordmark = true,
  showHome = false,
  fill = false,
} = Astro.props;

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: SITE.name,
  url: SITE.url,
  jobTitle: 'Web Developer & Designer',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Los Angeles',
    addressRegion: 'CA',
    addressCountry: 'US',
  },
  sameAs: [SITE.linkedin, SITE.github, SITE.twitter],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <SEO title={title} description={description} image={image} type={type} noindex={noindex} />

    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#EEE7E1" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1A1919" media="(prefers-color-scheme: dark)" />

    <link rel="sitemap" href="/sitemap-index.xml" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Bungee+Shade&family=Montserrat:wght@300;400;500;600&family=Playfair+Display:wght@400;500&display=swap"
    />

    <script is:inline>
      // Apply the stored theme before first paint so there's no flash.
      //
      // This has to run again after every client-side navigation: the router
      // swaps the document and replaces the <html> element's attributes with
      // the incoming page's, which carries no data-theme, so a stored choice
      // would silently revert to the system setting on the first link click.
      // astro:after-swap fires after the swap but before paint, so there's
      // still no flash.
      function applyStoredTheme() {
        try {
          var t = localStorage.getItem('theme');
          if (t === 'light' || t === 'dark') {
            document.documentElement.dataset.theme = t;
          } else {
            delete document.documentElement.dataset.theme;
          }
        } catch (e) {}
      }

      applyStoredTheme();
      document.addEventListener('astro:after-swap', applyStoredTheme);
    </script>

    <script
      type="application/ld+json"
      set:html={JSON.stringify(personSchema)}
    />
    <ClientRouter />
  </head>

  <body>
    <a href="#main" class="skip-link">Skip to content</a>

    <MenuOverlay />

    <div class="shell">
      <SideRail showHome={showHome} />

      <div class="shell__main wrap">
        <Header showWordmark={showWordmark} />

        <main id="main" class={`page-fade${fill ? ' shell__fill' : ''}`}>
          <slot />
        </main>

        <Footer />
      </div>
    </div>

    <!--
      Reveal-on-scroll. Everything marked [data-reveal] is visible by
      default in CSS and only hidden inside a prefers-reduced-motion:
      no-preference query, so a failed script or a reduced-motion
      preference leaves the page fully readable rather than blank.
    -->
    <script>
      function initReveal() {
        const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const targets = document.querySelectorAll('[data-reveal]:not(.is-in)');

        if (reduced || !('IntersectionObserver' in window)) {
          targets.forEach((el) => el.classList.add('is-in'));
          return;
        }

        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              entry.target.classList.add('is-in');
              io.unobserve(entry.target);
            });
          },
          { rootMargin: '0px 0px -12% 0px', threshold: 0.1 }
        );
        targets.forEach((el) => io.observe(el));
      }

      initReveal();
      document.addEventListener('astro:page-load', initReveal);

      /*
       * The display words lean toward the pointer. The original site skewed
       * them a flat -10deg on hover; this varies the angle by where the
       * cursor sits across the word, which gives the lean some weight
       * instead of making it a binary state. Pure enhancement: the CSS
       * default is the original -10deg, so nothing here is load-bearing.
       */
      function initSkew() {
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        if (!window.matchMedia('(hover: hover)').matches) return;

        document.querySelectorAll('.big-link').forEach((el) => {
          if (el.dataset.skewBound) return;
          el.dataset.skewBound = 'true';

          el.addEventListener('pointermove', (e) => {
            const box = el.getBoundingClientRect();
            if (!box.width) return;
            // -1 at the left edge, +1 at the right.
            const across = ((e.clientX - box.left) / box.width) * 2 - 1;
            // Leans further the further right the pointer is: -5deg to -15deg.
            el.style.setProperty('--skew', `${(-10 - across * 5).toFixed(2)}deg`);
          });

          el.addEventListener('pointerleave', () => {
            el.style.removeProperty('--skew');
          });
        });
      }

      initSkew();
      document.addEventListener('astro:page-load', initSkew);
    </script>
  </body>
</html>

<style>
  .shell__fill {
    flex: 1 0 auto;
    display: flex;
    flex-direction: column;
  }
</style>
