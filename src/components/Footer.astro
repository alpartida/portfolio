---
/**
 * The footer carries the full set of links on every page. That's partly
 * convention and partly the no-JavaScript fallback: if the overlay menu
 * never opens, this is still a complete way around the site.
 */
import { NAV, SITE } from '../config';

const year = new Date().getFullYear();
---

<footer class="foot">
  <div class="rule--h" aria-hidden="true"></div>

  <div class="foot__inner">
    <p class="foot__avail">{SITE.availability}</p>

    <div class="foot__cols">
      <nav aria-label="Pages">
        <ul class="foot__links">
          {NAV.map((l) => <li><a href={l.href} class="link-u">{l.label}</a></li>)}
        </ul>
      </nav>

      <nav aria-label="Elsewhere">
        <ul class="foot__links">
          <li><a href={SITE.linkedin} class="link-u">LinkedIn</a></li>
          <li><a href={SITE.github} class="link-u">GitHub</a></li>
          <li><a href="/AlexPartidaResume.pdf" class="link-u">Résumé</a></li>
        </ul>
      </nav>
    </div>
  </div>

  <p class="foot__base">
    &copy; {year} Alex Partida &middot; {SITE.location} &middot; Designed and
    built by me
  </p>
</footer>

<style>
  .foot {
    margin-top: var(--s-5);
    padding-bottom: clamp(2rem, 5vw, 3.5rem);
    flex: none;
  }

  .foot__inner {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3) var(--s-4);
    justify-content: space-between;
    align-items: baseline;
    padding-top: var(--s-3);
  }

  .foot__avail {
    max-width: 38ch;
    font-size: var(--t-sm);
    line-height: 1.9;
    color: var(--ink-soft);
  }

  .foot__cols {
    display: flex;
    gap: var(--s-4);
    flex-wrap: wrap;
  }

  .foot__links {
    display: grid;
    gap: var(--s-1);
    list-style: none;
    font-size: var(--t-sm);
    letter-spacing: 2px;
    text-transform: uppercase;
  }

  .foot__base {
    margin-top: var(--s-4);
    font-size: var(--t-sm);
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--ink-soft);
    line-height: 1.8;
  }
</style>
