---
import { SITE } from '../config';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <div class="stack-sm">
      <p class="footer-lead">{SITE.availability}</p>
      <p>
        <a href="/contact">Tell me about your project &rarr;</a>
      </p>
    </div>

    <nav aria-label="Elsewhere">
      <ul class="footer-links">
        <li><a href={SITE.linkedin}>LinkedIn</a></li>
        <li><a href={SITE.github}>GitHub</a></li>
        <li><a href="/AlexPartidaResume.pdf">Résumé (PDF)</a></li>
      </ul>
    </nav>
  </div>

  <div class="container site-footer__base">
    <p>&copy; {year} Alex Partida. Los Angeles, CA.</p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: auto;
    border-top: 1px solid var(--rule);
    background: var(--paper-2);
    padding-top: clamp(2.5rem, 6vw, var(--s-5));
  }

  .site-footer__inner {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-4);
    justify-content: space-between;
    align-items: start;
  }

  .footer-lead {
    font-family: var(--display);
    font-size: var(--step-1);
    color: var(--ink);
    max-width: 30ch;
  }

  .footer-links {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--s-1);
  }

  .site-footer__base {
    margin-top: var(--s-4);
    padding-bottom: var(--s-4);
    border-top: 1px solid var(--rule);
    padding-top: var(--s-3);
    color: var(--ink-soft);
    font-size: var(--step--1);
  }
</style>
