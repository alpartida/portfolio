---
import { SITE } from '../config';

const year = new Date().getFullYear();
---

<footer class="foot">
  <div class="rule--h" aria-hidden="true"></div>

  <div class="foot__inner">
    <p class="foot__avail">{SITE.availability}</p>

    <nav aria-label="Elsewhere">
      <ul class="foot__links">
        <li><a href="/contact" class="link-u">Start a project</a></li>
        <li><a href={SITE.linkedin} class="link-u">LinkedIn</a></li>
        <li><a href={SITE.github} class="link-u">GitHub</a></li>
        <li><a href="/AlexPartidaResume.pdf" class="link-u">Résumé</a></li>
      </ul>
    </nav>
  </div>

  <p class="foot__base">
    &copy; {year} Alex Partida &middot; {SITE.location} &middot; Designed and
    built by me
  </p>
</footer>

<style>
  .foot {
    margin-top: var(--s-5);
    padding-bottom: clamp(2rem, 5vw, 3.5rem);
  }

  .foot__inner {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
    justify-content: space-between;
    align-items: baseline;
    padding-top: var(--s-3);
  }

  .foot__avail {
    max-width: 40ch;
    font-size: var(--t-sm);
    line-height: 1.9;
    color: var(--ink-soft);
  }

  .foot__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-1) var(--s-3);
    list-style: none;
    font-size: var(--t-sm);
    letter-spacing: 2px;
    text-transform: uppercase;
  }

  .foot__base {
    margin-top: var(--s-3);
    font-size: var(--t-sm);
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--ink-soft);
    line-height: 1.8;
  }
</style>
