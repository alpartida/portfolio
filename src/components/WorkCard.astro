---
export interface Props {
  href: string;
  client: string;
  title: string;
  summary: string;
  year: string;
  stack: string[];
}

const { href, client, title, summary, year, stack } = Astro.props;
---

<article class="work-card">
  <div class="work-card__meta">
    <span class="eyebrow">{client}</span>
    <span class="work-card__year">{year}</span>
  </div>

  <h3 class="work-card__title">
    <a href={href}>{title}</a>
  </h3>

  <p class="work-card__summary">{summary}</p>

  <ul class="tags">
    {stack.slice(0, 4).map((s) => <li class="tag">{s}</li>)}
  </ul>
</article>

<style>
  .work-card {
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
    padding-block: var(--s-4);
    border-top: 1px solid var(--rule);
  }

  .work-card__meta {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--s-2);
  }

  .work-card__year {
    font-size: var(--step--1);
    color: var(--ink-soft);
    font-variant-numeric: tabular-nums;
  }

  .work-card__title {
    font-size: var(--step-2);
    max-width: 34ch;
  }

  .work-card__title a {
    color: var(--ink);
    text-decoration: none;
  }

  .work-card__title a:hover {
    color: var(--accent);
  }

  /* Make the whole heading row feel clickable without nesting links. */
  .work-card__title a::after {
    content: '\2192';
    color: var(--accent);
    display: inline-block;
    margin-left: 0.3em;
    transition: transform 0.15s ease;
  }

  .work-card__title a:hover::after {
    transform: translateX(3px);
  }

  .work-card__summary {
    color: var(--ink-soft);
    max-width: 58ch;
  }
</style>
