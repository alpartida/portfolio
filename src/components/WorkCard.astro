---
export interface Props {
  href: string;
  client: string;
  title: string;
  summary: string;
  year: string;
  stack: string[];
}

const { href, client, title, summary, year, stack } = Astro.props;
---

<article class="wc">
  <p class="meta wc__meta">
    <span>{client}</span>
    <span aria-hidden="true">·</span>
    <span>{year}</span>
  </p>

  <h3 class="wc__title">
    <a href={href}>{title}</a>
  </h3>

  <p class="wc__summary">{summary}</p>

  <ul class="tags">
    {stack.slice(0, 4).map((s) => <li class="tag">{s}</li>)}
  </ul>
</article>

<style>
  .wc {
    padding-block: var(--s-4);
    border-bottom: var(--rule-w) solid var(--rule-soft);
  }

  .wc__meta {
    display: flex;
    gap: 0.6rem;
    flex-wrap: wrap;
  }

  /* Montserrat, not Bungee. The display face is reserved for short
     words — a full sentence set in it is a wall, not a headline. */
  .wc__title {
    font-family: var(--body);
    font-weight: 600;
    font-size: var(--t-lg);
    line-height: 1.45;
    letter-spacing: var(--track);
    margin-top: var(--s-1);
    max-width: 34ch;
  }

  .wc__title a {
    display: inline-block;
    transition: opacity 0.2s ease, transform 0.25s ease;
  }

  .wc__title a:hover {
    opacity: 0.62;
    transform: translateX(0.05em);
  }

  .wc__summary {
    margin-top: var(--s-2);
    max-width: 58ch;
    color: var(--ink-soft);
  }

  .wc .tags {
    margin-top: var(--s-2);
  }
</style>
