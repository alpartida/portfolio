---
export interface Props {
  href: string;
  client: string;
  title: string;
  summary: string;
  year: string;
  stack: string[];
  /* Position in the list, so a run of cards reveals in sequence. */
  index?: number;
  /* Client, year and title only — used on the homepage, where the giant
     nav word is already the route into the work and the cards only need
     to say what exists. */
  compact?: boolean;
}

const {
  href,
  client,
  title,
  summary,
  year,
  stack,
  index = 0,
  compact = false,
} = Astro.props;
---

<article class:list={['wc', { 'is-compact': compact }]} data-reveal style={`--i:${index}`}>
  <p class="meta wc__meta">
    <span>{client}</span>
    <span aria-hidden="true">·</span>
    <span>{year}</span>
  </p>

  <h3 class="wc__title">
    <a href={href}>{title}</a>
  </h3>

  {!compact && <p class="wc__summary">{summary}</p>}

  {
    !compact && (
      <ul class="tags">
        {stack.slice(0, 4).map((s) => (
          <li class="tag">{s}</li>
        ))}
      </ul>
    )
  }
</article>

<style>
  .wc {
    padding-block: var(--s-4);
    border-bottom: var(--rule-w) solid var(--rule-soft);
  }

  /* Less to read means less room needed. */
  .wc.is-compact {
    padding-block: var(--s-3);
  }

  .wc__meta {
    display: flex;
    gap: 0.6rem;
    flex-wrap: wrap;
  }

  /* Montserrat, not Bungee. The display face is reserved for short
     words — a full sentence set in it is a wall, not a headline. */
  .wc__title {
    font-family: var(--body);
    font-weight: 600;
    font-size: var(--t-lg);
    line-height: 1.45;
    letter-spacing: var(--track);
    margin-top: var(--s-1);
    max-width: 34ch;
  }

  /* The underline arrives from the left on hover — the hairline motif
     again, rather than the dimming that every other link used to do. */
  .wc__title a {
    display: inline;
    background-image: linear-gradient(currentColor, currentColor);
    background-repeat: no-repeat;
    background-size: 0% 1px;
    background-position: 0 100%;
    transition: background-size 0.4s var(--ease-out);
  }

  .wc__title a:hover,
  .wc__title a:focus-visible {
    background-size: 100% 1px;
  }

  .wc__summary {
    margin-top: var(--s-2);
    max-width: 58ch;
    color: var(--ink-soft);
  }

  .wc .tags {
    margin-top: var(--s-2);
  }
</style>
