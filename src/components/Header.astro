---
/**
 * One navigation affordance, not two.
 *
 * The original site had no nav bar — the giant words were the navigation.
 * A small text nav running alongside them competed with the display type for
 * the same job, so the links now live in the full-screen overlay and this bar
 * holds only the wordmark, the theme switch, and the button that opens it.
 */
import { MENU } from '../copy';
import { SITE } from '../config';

const { showWordmark = true } = Astro.props;
---

<header class="top">
  {
    showWordmark ? (
      <a href="/" class="top__mark">{SITE.name}</a>
    ) : (
      <span class="top__spacer" />
    )
  }

  <button
    type="button"
    class="top__theme"
    data-theme-toggle
    aria-label="Switch between light and dark"
  >
    <svg class="i-sun" viewBox="0 0 24 24" aria-hidden="true">
      <circle cx="12" cy="12" r="4.4"></circle>
      <path
        d="M12 2.6v2.1M12 19.3v2.1M2.6 12h2.1M19.3 12h2.1M5.3 5.3l1.5 1.5M17.2 17.2l1.5 1.5M18.7 5.3l-1.5 1.5M6.8 17.2l-1.5 1.5"
      ></path>
    </svg>
    <svg class="i-moon" viewBox="0 0 24 24" aria-hidden="true">
      <path d="M20 14.5A8.5 8.5 0 1 1 9.5 4a7 7 0 0 0 10.5 10.5Z"></path>
    </svg>
  </button>

  <button
    type="button"
    class="top__menu"
    data-menu-open
    aria-expanded="false"
    aria-controls="site-menu"
  >
    <span>{MENU.open}</span>
    <span class="top__bars" aria-hidden="true">
      <i></i>
      <i></i>
    </span>
  </button>
</header>

<style>
  .top {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    padding-block: clamp(1.4rem, 3.5vh, 2.4rem);
    flex: none;
  }

  .top__mark,
  .top__spacer {
    margin-right: auto;
  }

  .top__mark {
    font-size: var(--t-sm);
    font-weight: 600;
    letter-spacing: 3px;
    text-transform: uppercase;
    transition: opacity 0.2s ease;
  }

  .top__mark:hover {
    opacity: 0.6;
  }

  .top__theme {
    background: none;
    border: none;
    color: var(--ink-soft);
    cursor: pointer;
    display: grid;
    place-items: center;
    /* 44px minimum target. */
    width: 2.75rem;
    height: 2.75rem;
    flex: none;
    transition: color 0.2s ease;
  }

  .top__theme:hover {
    color: var(--ink);
  }

  .top__theme svg {
    width: 1.05rem;
    height: 1.05rem;
    max-width: none;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.7;
    stroke-linecap: round;
  }

  .top__menu {
    background: none;
    border: none;
    cursor: pointer;
    color: var(--ink);
    font-family: var(--body);
    font-size: var(--t-sm);
    font-weight: 600;
    letter-spacing: 3px;
    text-transform: uppercase;
    display: inline-flex;
    align-items: center;
    gap: 0.7em;
    /* 44px minimum target. */
    min-height: 2.75rem;
    padding: 0.5em 0;
    flex: none;
    transition: opacity 0.2s ease;
  }

  .top__menu:hover {
    opacity: 0.6;
  }

  .top__bars {
    display: grid;
    gap: 5px;
    width: 26px;
  }

  .top__bars i {
    display: block;
    height: var(--rule-w);
    background: var(--ink);
    transition: transform 0.2s ease;
  }

  .top__menu:hover .top__bars i:first-child {
    transform: translateX(3px);
  }

  /* Show the icon for the theme you'd switch TO. */
  .i-moon,
  :global(:root[data-theme='dark']) .i-moon {
    display: none;
  }

  :global(:root[data-theme='dark']) .i-sun {
    display: block;
  }

  :global(:root[data-theme='light']) .i-sun {
    display: none;
  }

  :global(:root[data-theme='light']) .i-moon {
    display: block;
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .i-sun {
      display: block;
    }
    :global(:root:not([data-theme='light'])) .i-moon {
      display: none;
    }
  }

  @media (prefers-color-scheme: light) {
    :global(:root:not([data-theme='dark'])) .i-sun {
      display: none;
    }
    :global(:root:not([data-theme='dark'])) .i-moon {
      display: block;
    }
  }

  /* On a phone the word is redundant next to the bars. */
  @media (max-width: 420px) {
    .top__menu span:first-child {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
  }
</style>

<script>
  const toggle = document.querySelector('[data-theme-toggle]');

  const current = () => {
    const set = document.documentElement.dataset.theme;
    if (set) return set;
    return window.matchMedia('(prefers-color-scheme: dark)').matches
      ? 'dark'
      : 'light';
  };

  toggle?.addEventListener('click', () => {
    const next = current() === 'dark' ? 'light' : 'dark';
    document.documentElement.dataset.theme = next;
    try {
      localStorage.setItem('theme', next);
    } catch {
      /* private browsing — the choice just won't persist */
    }
  });
</script>
