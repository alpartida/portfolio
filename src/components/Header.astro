---
/**
 * A deliberately quiet top bar. The original site had no nav at all —
 * the giant Bungee Shade words on the homepage *were* the navigation.
 * With five pages that no longer stretches, so this sits small and
 * letterspaced in the corner and lets the display type stay the loudest
 * thing on the page.
 */
import { NAV } from '../config';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) =>
  href === '/' ? path === '/' : path === href || path.startsWith(href + '/');

const { showWordmark = true } = Astro.props;
---

<header class="top">
  {
    showWordmark ? (
      <a href="/" class="top__mark">
        Alex Partida
      </a>
    ) : (
      <span />
    )
  }

  <nav aria-label="Main">
    <ul class="top__nav">
      {
        NAV.map((l) => (
          <li>
            <a href={l.href} aria-current={isCurrent(l.href) ? 'page' : undefined}>
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  <button
    type="button"
    class="top__theme"
    data-theme-toggle
    aria-label="Switch between light and dark"
  >
    <svg class="i-sun" viewBox="0 0 24 24" aria-hidden="true">
      <circle cx="12" cy="12" r="4.4"></circle>
      <path
        d="M12 2.6v2.1M12 19.3v2.1M2.6 12h2.1M19.3 12h2.1M5.3 5.3l1.5 1.5M17.2 17.2l1.5 1.5M18.7 5.3l-1.5 1.5M6.8 17.2l-1.5 1.5"
      ></path>
    </svg>
    <svg class="i-moon" viewBox="0 0 24 24" aria-hidden="true">
      <path d="M20 14.5A8.5 8.5 0 1 1 9.5 4a7 7 0 0 0 10.5 10.5Z"></path>
    </svg>
  </button>
</header>

<style>
  .top {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    padding-block: clamp(1.4rem, 3.5vh, 2.4rem);
    flex-wrap: wrap;
  }

  .top__mark {
    font-size: var(--t-sm);
    font-weight: 600;
    letter-spacing: 3px;
    text-transform: uppercase;
    margin-right: auto;
    transition: opacity 0.2s ease;
  }

  .top__mark:hover {
    opacity: 0.6;
  }

  /* When the wordmark is suppressed (homepage), still push the nav right. */
  .top > span {
    margin-right: auto;
  }

  .top__nav {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-1) var(--s-3);
    list-style: none;
  }

  .top__nav a {
    font-size: var(--t-sm);
    font-weight: 500;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--ink-soft);
    padding-bottom: 0.35em;
    border-bottom: var(--rule-w) solid transparent;
    transition: color 0.2s ease, border-color 0.2s ease;
  }

  .top__nav a:hover {
    color: var(--ink);
  }

  .top__nav a[aria-current='page'] {
    color: var(--ink);
    border-bottom-color: var(--ink);
  }

  .top__theme {
    background: none;
    border: none;
    color: var(--ink-soft);
    cursor: pointer;
    display: grid;
    place-items: center;
    width: 1.9rem;
    height: 1.9rem;
    flex: none;
    transition: color 0.2s ease;
  }

  .top__theme:hover {
    color: var(--ink);
  }

  .top__theme svg {
    width: 1rem;
    height: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.7;
    stroke-linecap: round;
  }

  /* Show the icon for the theme you'd switch TO. */
  .i-moon,
  :global(:root[data-theme='dark']) .i-moon {
    display: none;
  }

  :global(:root[data-theme='dark']) .i-sun {
    display: block;
  }

  :global(:root[data-theme='light']) .i-sun {
    display: none;
  }

  :global(:root[data-theme='light']) .i-moon {
    display: block;
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .i-sun {
      display: block;
    }
    :global(:root:not([data-theme='light'])) .i-moon {
      display: none;
    }
  }

  @media (prefers-color-scheme: light) {
    :global(:root:not([data-theme='dark'])) .i-sun {
      display: none;
    }
    :global(:root:not([data-theme='dark'])) .i-moon {
      display: block;
    }
  }

  /* Keep the nav and the theme toggle on one row; let the nav itself
     wrap if it must, rather than pushing the button onto its own line. */
  @media (max-width: 620px) {
    .top {
      gap: var(--s-2);
      row-gap: var(--s-1);
      flex-wrap: nowrap;
      align-items: center;
    }

    .top__mark {
      display: none;
    }

    .top > span {
      display: none;
    }

    .top__nav {
      flex: 1 1 auto;
      gap: var(--s-1) var(--s-2);
      justify-content: flex-start;
    }

    .top__nav a {
      letter-spacing: 1.4px;
    }
  }
</style>

<script>
  const toggle = document.querySelector('[data-theme-toggle]');

  const current = () => {
    const set = document.documentElement.dataset.theme;
    if (set) return set;
    return window.matchMedia('(prefers-color-scheme: dark)').matches
      ? 'dark'
      : 'light';
  };

  toggle?.addEventListener('click', () => {
    const next = current() === 'dark' ? 'light' : 'dark';
    document.documentElement.dataset.theme = next;
    try {
      localStorage.setItem('theme', next);
    } catch {
      /* private browsing — the choice just won't persist */
    }
  });
</script>
