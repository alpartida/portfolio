---
/**
 * The menu IS the giant type.
 *
 * The original site's navigation was three enormous Bungee Shade words.
 * Adding a small text nav alongside them created two competing affordances
 * for the same job, so there's now exactly one: a single MENU button that
 * opens this, full screen, with the display type doing the work.
 *
 * Progressive enhancement: with JavaScript off the overlay never opens, so
 * the footer carries the full set of links on every page as the fallback.
 */
import { NAV, SITE } from '../config';
import { MENU } from '../copy';

const longestWord = (s: string) =>
  Math.max(...s.split(/\s+/).map((w) => w.length));

const items = [{ href: '/', label: 'Home' }, ...NAV];

const socials = [
  { label: 'LinkedIn', href: SITE.linkedin },
  { label: 'GitHub', href: SITE.github },
  { label: 'Twitter', href: SITE.twitter },
];

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) =>
  href === '/' ? path === '/' : path === href || path.startsWith(href + '/');
---

<div class="menu" id="site-menu" role="dialog" aria-modal="true" aria-label="Menu" hidden>
  <div class="menu__bar">
    <span class="menu__mark">{SITE.name}</span>
    <button type="button" class="menu__close" data-menu-close>
      {MENU.close}
      <span aria-hidden="true" class="menu__x">&times;</span>
    </button>
  </div>

  <nav class="menu__nav" aria-label="Menu">
    <ul>
      {
        items.map((l, i) => (
          <li style={`--i:${i}`}>
            <a
              href={l.href}
              class="big-link menu__link"
              style={`--chars:${longestWord(l.label)}`}
              aria-current={isCurrent(l.href) ? 'page' : undefined}
            >
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  <div class="menu__foot">
    <ul class="menu__social">
      {
        socials.map((s) => (
          <li>
            <a href={s.href} rel="me noopener" class="link-u">
              {s.label}
            </a>
          </li>
        ))
      }
    </ul>
    <p class="menu__note">{SITE.location}</p>
  </div>
</div>

<style>
  .menu {
    position: fixed;
    inset: 0;
    z-index: 150;
    background: var(--cream);
    display: flex;
    flex-direction: column;
    padding-inline: var(--gutter);
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .menu[hidden] {
    display: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    .menu__nav li {
      animation: menu-word-in 0.5s var(--ease-out) both;
      animation-delay: calc(var(--i) * 55ms + 80ms);
    }

    @keyframes menu-word-in {
      from {
        opacity: 0;
        transform: translateY(0.3em);
      }
      to {
        opacity: 1;
        transform: none;
      }
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .menu:not([hidden]) {
      animation: menu-in 0.28s ease both;
    }
  }

  @keyframes menu-in {
    from {
      opacity: 0;
      transform: translateY(-0.5rem);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .menu__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-3);
    padding-block: clamp(1.4rem, 3.5vh, 2.4rem);
    flex: none;
  }

  .menu__mark,
  .menu__close {
    font-family: var(--body);
    font-size: var(--t-sm);
    font-weight: 600;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: var(--ink);
  }

  .menu__close {
    background: none;
    border: none;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    padding: 0.5em 0;
    transition: opacity 0.2s ease;
  }

  .menu__close:hover {
    opacity: 0.6;
  }

  .menu__x {
    font-size: 1.5em;
    line-height: 0.6;
    letter-spacing: 0;
  }

  /* The words carry the page, so they get the vertical space. */
  .menu__nav {
    flex: 1 0 auto;
    display: flex;
    align-items: center;
    container-type: inline-size;
    padding-block: var(--s-3);
  }

  .menu__nav ul {
    list-style: none;
    width: 100%;
  }

  /* Each word fills the column's width, so the five of them stack into a
     justified block — short words set large, long words smaller, all the
     same width. Capped so they don't get absurd on a wide monitor. */
  .menu__link {
    font-size: min(calc(100cqw / (var(--chars) * 0.9)), 5.5rem);
    margin-bottom: 0.08em;
  }

  .menu__link[aria-current='page'] {
    opacity: 0.45;
  }

  .menu__foot {
    flex: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2) var(--s-3);
    align-items: baseline;
    justify-content: space-between;
    padding-block: clamp(1.4rem, 3.5vh, 2.4rem);
    border-top: var(--rule-w) solid var(--rule-soft);
  }

  .menu__social {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-1) var(--s-3);
    list-style: none;
    font-size: var(--t-sm);
    letter-spacing: 2px;
    text-transform: uppercase;
  }

  .menu__note {
    font-size: var(--t-sm);
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--ink-soft);
  }
</style>

<script>
  const menu = document.getElementById('site-menu');
  const openBtn = document.querySelector<HTMLButtonElement>('[data-menu-open]');
  const closeBtn = menu?.querySelector<HTMLButtonElement>('[data-menu-close]');

  if (menu && openBtn && closeBtn) {
    const focusable = () =>
      Array.from(
        menu.querySelectorAll<HTMLElement>('a[href], button:not([disabled])')
      ).filter((el) => el.offsetParent !== null);

    const open = () => {
      menu.hidden = false;
      openBtn.setAttribute('aria-expanded', 'true');
      // Lock the page behind the overlay without losing scroll position.
      document.body.style.overflow = 'hidden';
      closeBtn.focus();
      document.addEventListener('keydown', onKeydown);
    };

    const close = () => {
      menu.hidden = true;
      openBtn.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
      document.removeEventListener('keydown', onKeydown);
      // Focus always returns to the button that opened the menu — it's the
      // invoker, and it's guaranteed to still be in the document.
      openBtn.focus();
    };

    function onKeydown(e: KeyboardEvent) {
      if (e.key === 'Escape') {
        e.preventDefault();
        close();
        return;
      }

      if (e.key !== 'Tab') return;

      // Keep focus inside the overlay while it's open.
      const items = focusable();
      if (items.length === 0) return;
      const first = items[0];
      const last = items[items.length - 1];

      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    }

    openBtn.addEventListener('click', open);
    closeBtn.addEventListener('click', close);
  }
</script>
